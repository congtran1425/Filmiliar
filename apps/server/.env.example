# ==========================================
# Filmiliar Server Environment Configuration (Template)
# ==========================================
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL trên Oracle VPS hoặc Local/Cloud)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/filmiliar_db?schema=public"

# Bảo mật JWT cho đăng nhập & xác thực (tối thiểu 32 ký tự)
JWT_SECRET="replace_with_a_secure_jwt_secret_of_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# CORS Origin (cho phép Frontend từ Vite local và Vercel)
CORS_ORIGIN="http://localhost:5173,https://filmiliar.congtc145.id.vn"

# Trạng thái danh mục mẫu và upload
DEMO_CATALOG="true"
ENABLE_UPLOADS="false"

# ==========================================
# Cấu hình Cổng thanh toán ZaloPay Sandbox
# ==========================================
# PAYMENT_MODE: 'sandbox' (bật thử nghiệm VietQR ZaloPay) hoặc 'disabled' (tắt cổng)
PAYMENT_MODE="sandbox"
ZALOPAY_APP_ID="2553"
ZALOPAY_KEY1="your_zalopay_sandbox_key1"
ZALOPAY_KEY2="your_zalopay_sandbox_key2"
ZALOPAY_ENDPOINT="https://sb-openapi.zalopay.vn/v2/create"
ZALOPAY_QUERY_ENDPOINT="https://sb-openapi.zalopay.vn/v2/query"
ZALOPAY_CALLBACK_URL="https://api-filmiliar.congtc145.id.vn/api/payment/callback"

# ==========================================
# Cấu hình Lưu trữ ảnh sang Hosting iNet
# ==========================================
# STORAGE_MODE: 'local' (lưu cục bộ), 'http_api' (upload qua PHP API), 'ftp' (upload FTP)
STORAGE_MODE="http_api"
MEDIA_PUBLIC_URL="https://media.congtc145.id.vn"

# Cách A: HTTP Upload API qua file api_upload.php
INET_UPLOAD_ENDPOINT="https://media.congtc145.id.vn/api_upload.php"
INET_UPLOAD_SECRET_KEY="your_secret_upload_key"

# Cách B: FTP Backup
INET_FTP_HOST="ftp.congtc145.id.vn"
INET_FTP_PORT=21
INET_FTP_USER="your_ftp_username"
INET_FTP_PASSWORD="your_ftp_password"
INET_FTP_REMOTE_DIR="/home/your_user/public_html"

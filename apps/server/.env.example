# Filmiliar Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database connection (PostgreSQL on Oracle VPS localhost:5432 or Cloud)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/filmiliar_db?schema=public"

# JWT Secret for User/Admin auth
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# CORS Origin (Frontend domain on Vercel)
CORS_ORIGIN="http://localhost:5173,https://filmiliar.congtc145.id.vn"

# Admin-only ZaloPay Sandbox; leave disabled while deposit and refund policy is unapproved.
PAYMENT_MODE="disabled"
ZALOPAY_APP_ID=""
ZALOPAY_KEY1=""
ZALOPAY_KEY2=""
ZALOPAY_CALLBACK_URL="https://api-filmiliar.congtc145.id.vn/api/payment/callback"

# iNet Free Hosting Configuration (Media Storage)
# Mode: 'ftp' (tự động đẩy ảnh qua FTP) hoặc 'local' (lưu cục bộ test)
STORAGE_MODE="local"
INET_FTP_HOST="ftp.congtc145.id.vn"
INET_FTP_PORT=21
INET_FTP_USER="your_ftp_username"
INET_FTP_PASSWORD="your_ftp_password"
INET_FTP_REMOTE_DIR="/public_html/filmiliar/uploads"
MEDIA_PUBLIC_URL="https://media.congtc145.id.vn/filmiliar/uploads"

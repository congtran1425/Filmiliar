{
  "name": "@filmiliar/server",
  "version": "1.0.0",
  "description": "Backend API service for Filmiliar E-commerce platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:payment:integration": "npm run build && node --test tests/payment-flow.integration.test.mjs",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",

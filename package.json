{
  "name": "filmiliar-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Nền tảng thương mại điện tử cho thuê và bán máy ảnh second-hand kiểm định Filmiliar",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=apps/server run dev",
    "dev:client": "npm --workspace=apps/client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --workspace=apps/server run build",
    "build:client": "npm --workspace=apps/client run build",
    "build": "npm run build:server && npm run build:client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
